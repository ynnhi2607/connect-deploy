[Unit]
Description=Back up the Connect production MySQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/opt/connect
Environment=DEPLOY_PATH=/opt/connect
Environment=BACKUP_RETENTION_DAYS=7
Environment=AZURE_BACKUP_CONTAINER_URL=https://stconnectnanest2607.blob.core.windows.net/mysql-backups
UMask=0077
ExecStart=/opt/connect/scripts/backup-mysql.sh
